<?xml version="1.0" encoding="utf-8"?>
<ContentPage
    x:Class="Catch_your_bus.Views.RouteCalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Catch_your_bus.ViewModels"
    xmlns:response="clr-namespace:Catch_your_bus.Models.External.GooglePlaces.Response"
    xmlns:entities="clr-namespace:Catch_your_bus.Models.Entities"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    x:DataType="vm:RouteCalculationViewModel"
    Title="Route Calculator"
    BackgroundColor="#1A1A2E">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryAccent">#6C63FF</Color>
            <Color x:Key="SurfaceColor">#16213E</Color>
            <Color x:Key="SurfaceLighter">#1F3060</Color>
            <Color x:Key="TextPrimary">#E8E8E8</Color>
            <Color x:Key="TextSecondary">#A0A0B0</Color>
            <Color x:Key="ErrorRed">#FF6B6B</Color>
            <Color x:Key="WarningYellow">#FFD166</Color>
            <Color x:Key="SuccessGreen">#4ECDC4</Color>
            <Color x:Key="RunningOrange">#FF8C42</Color>
            
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="StringIsNotNullOrEmptyConverter" />
            <toolkit:IsStringNotNullOrEmptyConverter x:Key="IsNotNullConverter" />

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
            </Style>

            <Style x:Key="SearchEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLighter}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>

            <Style x:Key="TabButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HeightRequest" Value="40" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="🚌 Catch Your Bus!" FontSize="28" FontAttributes="Bold"
                   TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center" Margin="0,8,0,4" />
            <Label Text="Find out if you should run or ride" FontSize="14" TextColor="{StaticResource TextSecondary}"
                   HorizontalTextAlignment="Center" Margin="0,0,0,8" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionLabel}" Text="START LOCATION" />
                    <Entry Style="{StaticResource SearchEntry}" Placeholder="Search for a place..."
                           Text="{Binding StartQuery, Mode=TwoWay}" x:Name="StartEntry"
                           TextChanged="OnStartTextChanged" />
                    <CollectionView ItemsSource="{Binding StartPredictions}" IsVisible="{Binding HasStartPredictions}"
                                    SelectionMode="Single" SelectionChanged="OnStartPredictionSelected"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="response:PlacePrediction">
                                <Border BackgroundColor="{StaticResource SurfaceLighter}" StrokeThickness="0"
                                        Padding="14,10" Margin="0,2" StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding DisplayText}" TextColor="{StaticResource TextPrimary}"
                                           FontSize="14" LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label Style="{StaticResource SectionLabel}" Text="DESTINATION" />
                    <Entry Style="{StaticResource SearchEntry}" Placeholder="Search for a place..."
                           Text="{Binding EndQuery, Mode=TwoWay}" x:Name="EndEntry" TextChanged="OnEndTextChanged" />
                    <CollectionView ItemsSource="{Binding EndPredictions}" IsVisible="{Binding HasEndPredictions}"
                                    SelectionMode="Single" SelectionChanged="OnEndPredictionSelected"
                                    HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="response:PlacePrediction">
                                <Border BackgroundColor="{StaticResource SurfaceLighter}" StrokeThickness="0"
                                        Padding="14,10" Margin="0,2" StrokeShape="RoundRectangle 8">
                                    <Label Text="{Binding DisplayText}" TextColor="{StaticResource TextPrimary}"
                                           FontSize="14" LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>

            <Button Text="Calculate Route" Command="{Binding CalculateBestRouteCommand}" FontSize="16"
                    FontAttributes="Bold" TextColor="White" BackgroundColor="{StaticResource PrimaryAccent}"
                    CornerRadius="14" HeightRequest="52" Margin="0,4,0,0" x:Name="CalculateButton" />

            <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                               Color="{StaticResource PrimaryAccent}" HeightRequest="40" HorizontalOptions="Center" />

            <Border IsVisible="{Binding HasError}" BackgroundColor="#3D1515" StrokeThickness="1"
                    Stroke="{StaticResource ErrorRed}" Padding="16" StrokeShape="RoundRectangle 12">
                <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource ErrorRed}" FontSize="14"
                       HorizontalTextAlignment="Center" />
            </Border>

            <VerticalStackLayout IsVisible="{Binding HasBundle}" Spacing="16" Margin="0,8,0,20">

                <Border
                    IsVisible="{Binding StandardTransitWarning, Converter={StaticResource StringIsNotNullOrEmptyConverter}, FallbackValue=False}"
                    BackgroundColor="#4D2B18" Stroke="{StaticResource RunningOrange}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="12">
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="⚠️" FontSize="18" VerticalOptions="Center" />
                        <Label Text="{Binding StandardTransitWarning}" TextColor="{StaticResource RunningOrange}"
                               FontSize="15" FontAttributes="Bold" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="{StaticResource SurfaceLighter}" StrokeThickness="0"
                        StrokeShape="RoundRectangle 12" Padding="4">
                    <Grid ColumnDefinitions="*,*,*">
                        <Button Grid.Column="0" Text="🏆 Fastest" Command="{Binding SwitchTabCommand}"
                                CommandParameter="{x:Static vm:TravelTab.Fastest}" Style="{StaticResource TabButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsFastestTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="1" Text="🚌 Transit" Command="{Binding SwitchTabCommand}"
                                CommandParameter="{x:Static vm:TravelTab.Transit}" Style="{StaticResource TabButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsTransitTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Grid.Column="2" Text="👟 On Foot" Command="{Binding SwitchTabCommand}"
                                CommandParameter="{x:Static vm:TravelTab.OnFoot}" Style="{StaticResource TabButton}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding IsOnFootTab}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource PrimaryAccent}" />
                                    <Setter Property="TextColor" Value="White" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                    </Grid>
                </Border>

                <VerticalStackLayout IsVisible="{Binding IsFastestTab}" Spacing="16">

                    <Border Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewRouteDetailsCommand}" CommandParameter="{Binding CurrentBundle.Winner}" />
                        </Border.GestureRecognizers>
                        
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#6C63FF" Offset="0.0" />
                                <GradientStop Color="#3F3D94" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>

                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="Absolute Best Route" FontSize="12" TextColor="#D0D0FF" FontAttributes="Bold" HorizontalTextAlignment="Center" />
                                <Label Text="{Binding WinnerText}" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />

                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Margin="0,8,0,0">
                                    <Label Text="{Binding CurrentBundle.Winner.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}" FontSize="24" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="•" FontSize="20" TextColor="#D0D0FF" VerticalOptions="Center" />
                                    <Label Text="{Binding CurrentBundle.Winner.ArrivalTime, StringFormat='Arrive at {0:HH:mm}'}" FontSize="16" TextColor="#D0D0FF" VerticalOptions="Center" />
                                </HorizontalStackLayout>

                                <Border IsVisible="{Binding HasWinnerBadge}"
                                        BackgroundColor="{StaticResource RunningOrange}" StrokeThickness="0"
                                        Padding="12,6"
                                        HorizontalOptions="Center" StrokeShape="RoundRectangle 8" Margin="0,8,0,0">
                                    <Label Text="{Binding WinnerBadgeText}" FontSize="13"
                                           FontAttributes="Bold" TextColor="White" />
                                </Border>
                            </VerticalStackLayout>
                            
                            <Label Grid.Column="1" Text="❯" FontSize="24" FontAttributes="Bold" TextColor="#D0D0FF" VerticalOptions="Center" Margin="16,0,0,0" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
                                
                <VerticalStackLayout IsVisible="{Binding IsTransitTab}" Spacing="16">
                    <Label Text="Compare transit options" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                    
                    <Border IsVisible="{Binding HasRunningAlternative}" Style="{StaticResource CardBorder}" Stroke="{StaticResource RunningOrange}" StrokeThickness="2">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewRouteDetailsCommand}" CommandParameter="{Binding CurrentBundle.RunningAlternative}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4" ColumnSpacing="16">
                            <Label Grid.RowSpan="3" Grid.Column="0" Text="🔥" FontSize="32" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Run to catch earlier bus" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBundle.RunningAlternative.Summary}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                                <Label Text="{Binding CurrentBundle.RunningAlternative.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                                <Label Text="{Binding CurrentBundle.RunningAlternative.ArrivalTime, StringFormat='Arrive {0:HH:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource RunningOrange}" />
                            </HorizontalStackLayout>
                            <Label Grid.RowSpan="3" Grid.Column="2" Text="❯" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    
                    <Border IsVisible="{Binding CurrentBundle.StandardTransit, Converter={StaticResource IsNotNullConverter}}" Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewRouteDetailsCommand}" CommandParameter="{Binding CurrentBundle.StandardTransit}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto, Auto" RowSpacing="4" ColumnSpacing="16">
                            <Label Grid.RowSpan="3" Grid.Column="0" Text="🚌" FontSize="32" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Standard Transit" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentBundle.StandardTransit.Summary}" FontSize="13" TextColor="{StaticResource TextSecondary}" LineBreakMode="TailTruncation" />
                            <HorizontalStackLayout Grid.Row="2" Grid.Column="1" Spacing="8">
                                <Label Text="{Binding CurrentBundle.StandardTransit.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                                <Label Text="{Binding CurrentBundle.StandardTransit.ArrivalTime, StringFormat='Arrive {0:HH:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryAccent}" />
                            </HorizontalStackLayout>
                            <Label Grid.RowSpan="3" Grid.Column="2" Text="❯" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
                
                <VerticalStackLayout IsVisible="{Binding IsOnFootTab}" Spacing="16">
                    <Label Text="Compare walking vs. running" FontSize="14" TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />

                    <Border IsVisible="{Binding CurrentBundle.PureRunning, Converter={StaticResource IsNotNullConverter}}" Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewRouteDetailsCommand}" CommandParameter="{Binding CurrentBundle.PureRunning}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" RowSpacing="4" ColumnSpacing="16">
                            <Label Grid.RowSpan="2" Grid.Column="0" Text="🏃" FontSize="32" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Pure Run" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="{Binding CurrentBundle.PureRunning.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="14"/>
                                <Label Text="{Binding CurrentBundle.PureRunning.ArrivalTime, StringFormat='Arrive {0:HH:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource RunningOrange}" />
                            </HorizontalStackLayout>
                            <Label Grid.RowSpan="2" Grid.Column="2" Text="❯" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                    
                    <Border IsVisible="{Binding CurrentBundle.PureWalking, Converter={StaticResource IsNotNullConverter}}" Style="{StaticResource CardBorder}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewRouteDetailsCommand}" CommandParameter="{Binding CurrentBundle.PureWalking}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="Auto, *, Auto" RowDefinitions="Auto, Auto" RowSpacing="4" ColumnSpacing="16">
                            <Label Grid.RowSpan="2" Grid.Column="0" Text="🚶" FontSize="32" VerticalOptions="Center" />
                            <Label Grid.Row="0" Grid.Column="1" Text="Pure Walk" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                            <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8">
                                <Label Text="{Binding CurrentBundle.PureWalking.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}" FontSize="14" TextColor="{StaticResource TextSecondary}" />
                                <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="14" />
                                <Label Text="{Binding CurrentBundle.PureWalking.ArrivalTime, StringFormat='Arrive {0:HH:mm}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryAccent}" />
                            </HorizontalStackLayout>
                            <Label Grid.RowSpan="2" Grid.Column="2" Text="❯" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}" VerticalOptions="Center" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>