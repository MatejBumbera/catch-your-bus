<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="Catch_your_bus.Views.RouteCalculationPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:Catch_your_bus.ViewModels"
    xmlns:places="clr-namespace:Catch_your_bus.Models.External.GooglePlaces"
    xmlns:response="clr-namespace:Catch_your_bus.Models.External.GooglePlaces.Response"
    x:DataType="vm:RouteCalculationViewModel"
    Title="Route Calculator"
    BackgroundColor="#1A1A2E">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryAccent">#6C63FF</Color>
            <Color x:Key="SurfaceColor">#16213E</Color>
            <Color x:Key="SurfaceLighter">#1F3060</Color>
            <Color x:Key="TextPrimary">#E8E8E8</Color>
            <Color x:Key="TextSecondary">#A0A0B0</Color>
            <Color x:Key="ErrorRed">#FF6B6B</Color>
            <Color x:Key="SuccessGreen">#4ECDC4</Color>
            <Color x:Key="RunningOrange">#FF8C42</Color>

            <Style x:Key="CardBorder" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="Padding" Value="20" />
                <Setter Property="StrokeShape" Value="RoundRectangle 16" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="1.2" />
            </Style>

            <Style x:Key="SearchEntry" TargetType="Entry">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceLighter}" />
                <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout
            Padding="20"
            Spacing="16">

            <Label
                Text="🚌 Catch Your Bus!"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="{StaticResource TextPrimary}"
                HorizontalTextAlignment="Center"
                Margin="0,8,0,4" />

            <Label
                Text="Find out if you should run or ride"
                FontSize="14"
                TextColor="{StaticResource TextSecondary}"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,8" />

            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource SectionLabel}"
                        Text="START LOCATION" />

                    <Entry
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search for a place..."
                        Text="{Binding StartQuery, Mode=TwoWay}"
                        x:Name="StartEntry"
                        TextChanged="OnStartTextChanged" />
                    
                    <CollectionView
                        ItemsSource="{Binding StartPredictions}"
                        IsVisible="{Binding HasStartPredictions}"
                        SelectionMode="Single"
                        SelectionChanged="OnStartPredictionSelected"
                        HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="response:PlacePrediction">
                                <Border
                                    BackgroundColor="{StaticResource SurfaceLighter}"
                                    StrokeThickness="0"
                                    Padding="14,10"
                                    Margin="0,2"
                                    StrokeShape="RoundRectangle 8">
                                    <Label
                                        Text="{Binding DisplayText}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            
            <Border Style="{StaticResource CardBorder}">
                <VerticalStackLayout Spacing="8">
                    <Label
                        Style="{StaticResource SectionLabel}"
                        Text="DESTINATION" />

                    <Entry
                        Style="{StaticResource SearchEntry}"
                        Placeholder="Search for a place..."
                        Text="{Binding EndQuery, Mode=TwoWay}"
                        x:Name="EndEntry"
                        TextChanged="OnEndTextChanged" />
                    
                    <CollectionView
                        ItemsSource="{Binding EndPredictions}"
                        IsVisible="{Binding HasEndPredictions}"
                        SelectionMode="Single"
                        SelectionChanged="OnEndPredictionSelected"
                        HeightRequest="180">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="response:PlacePrediction">
                                <Border
                                    BackgroundColor="{StaticResource SurfaceLighter}"
                                    StrokeThickness="0"
                                    Padding="14,10"
                                    Margin="0,2"
                                    StrokeShape="RoundRectangle 8">
                                    <Label
                                        Text="{Binding DisplayText}"
                                        TextColor="{StaticResource TextPrimary}"
                                        FontSize="14"
                                        LineBreakMode="TailTruncation" />
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Border>
            
            <Button
                Text="Calculate Route"
                Command="{Binding CalculateBestRouteCommand}"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"
                BackgroundColor="{StaticResource PrimaryAccent}"
                CornerRadius="14"
                HeightRequest="52"
                Margin="0,4,0,0"
                x:Name="CalculateButton" />

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="{StaticResource PrimaryAccent}"
                HeightRequest="40"
                HorizontalOptions="Center" />

            <Border
                IsVisible="{Binding HasError}"
                BackgroundColor="#3D1515"
                StrokeThickness="1"
                Stroke="{StaticResource ErrorRed}"
                Padding="16"
                StrokeShape="RoundRectangle 12">
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="{StaticResource ErrorRed}"
                    FontSize="14"
                    HorizontalTextAlignment="Center" />
            </Border>

            <Border
                IsVisible="{Binding HasResult}"
                Padding="24"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 20"
                x:Name="WinnerBanner">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#6C63FF" Offset="0.0" />
                        <GradientStop Color="#3F3D94" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <VerticalStackLayout Spacing="8">
                    <Label
                        Text="{Binding WinnerText}"
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="{Binding DifferenceText}"
                        FontSize="16"
                        TextColor="#D0D0FF"
                        HorizontalTextAlignment="Center" />

                    <Border
                        IsVisible="{Binding IsRunningAlternative}"
                        BackgroundColor="{StaticResource RunningOrange}"
                        StrokeThickness="0"
                        Padding="12,8"
                        HorizontalOptions="Center"
                        StrokeShape="RoundRectangle 10"
                        Margin="0,8,0,0">
                        <Label
                            Text="🔥 Run to catch an earlier bus!"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <Grid
                IsVisible="{Binding HasResult}"
                ColumnDefinitions="*,12,*"
                RowDefinitions="Auto"
                Margin="0,4,0,16">

                <Border
                    Grid.Column="0"
                    Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="🚌"
                            FontSize="28"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Transit Option"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource SuccessGreen}"
                            HorizontalTextAlignment="Center" />
                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource SurfaceLighter}"
                            Margin="0,4" />
                        <Label
                            Text="{Binding TransitRouteSummary}"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>

                <Border
                    Grid.Column="2"
                    Style="{StaticResource CardBorder}">
                    <VerticalStackLayout Spacing="8">
                        <Label
                            Text="🏃"
                            FontSize="28"
                            HorizontalTextAlignment="Center" />
                        <Label
                            Text="Running Option"
                            FontSize="13"
                            FontAttributes="Bold"
                            TextColor="{StaticResource RunningOrange}"
                            HorizontalTextAlignment="Center" />
                        <BoxView
                            HeightRequest="1"
                            Color="{StaticResource SurfaceLighter}"
                            Margin="0,4" />
                        <Label
                            Text="{Binding FootRouteSummary}"
                            FontSize="13"
                            TextColor="{StaticResource TextPrimary}"
                            HorizontalTextAlignment="Center"
                            LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
