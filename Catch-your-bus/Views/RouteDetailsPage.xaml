<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Catch_your_bus.Views.RouteDetailsPage"
             xmlns:vm="clr-namespace:Catch_your_bus.ViewModels"
             xmlns:entities="clr-namespace:Catch_your_bus.Models.Entities"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:DataType="vm:RouteDetailsViewModel"
             Title="Trip Details"
             BackgroundColor="#1A1A2E">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryAccent">#6C63FF</Color>
            <Color x:Key="SurfaceColor">#16213E</Color>
            <Color x:Key="SurfaceLighter">#1F3060</Color>
            <Color x:Key="TextPrimary">#E8E8E8</Color>
            <Color x:Key="TextSecondary">#A0A0B0</Color>
            <Color x:Key="WarningYellow">#FFD166</Color>

            <toolkit:IsNotNullConverter x:Key="IsNotNullConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <Border BackgroundColor="{StaticResource SurfaceColor}" StrokeThickness="0" Padding="20"
                    StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding Route.Summary}" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource TextPrimary}" HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap" />

                    <BoxView HeightRequest="1" Color="{StaticResource SurfaceLighter}" Margin="0,8" />

                    <Grid ColumnDefinitions="*, Auto, *">
                        <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Leave" FontSize="12" TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Route.DepartureTime, StringFormat='{0:HH:mm}'}" FontSize="18"
                                   FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2" Margin="20,0">
                            <Label Text="{Binding Route.TotalDuration.TotalMinutes, StringFormat='{0:F0} min'}"
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource PrimaryAccent}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Route.TotalDistanceMeters, StringFormat='{0:F0} m'}" FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                            <Label Text="Arrive" FontSize="12" TextColor="{StaticResource TextSecondary}"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="{Binding Route.ArrivalTime, StringFormat='{0:HH:mm}'}" FontSize="18"
                                   FontAttributes="Bold" TextColor="{StaticResource TextPrimary}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="STEP BY STEP" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"
                   CharacterSpacing="1.2" Margin="0,8,0,0" />

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Route.Segments}" Spacing="0">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:RouteSegment">
                        <Grid ColumnDefinitions="60, *" RowDefinitions="Auto, Auto" Margin="0,0,0,16">

                            <Grid Grid.Column="0" RowDefinitions="Auto, *, Auto" RowSpacing="0"
                                  HorizontalOptions="Center" WidthRequest="60">
                                <VerticalStackLayout Grid.Row="0" HorizontalOptions="Center" Spacing="0">
                                    <Label Text="{Binding StartTime, StringFormat='{0:HH:mm}'}" FontSize="12"
                                           FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"
                                           HorizontalTextAlignment="Center" Margin="0,0,0,2" />
                                    <BoxView WidthRequest="14" HeightRequest="14" CornerRadius="7"
                                             BackgroundColor="{StaticResource PrimaryAccent}"
                                             HorizontalOptions="Center" />
                                </VerticalStackLayout>

                                <BoxView Grid.Row="1" WidthRequest="2"
                                         BackgroundColor="{StaticResource SurfaceLighter}" Margin="0"
                                         HorizontalOptions="Center" VerticalOptions="Fill" />
                                <Label Grid.Row="2" Text="{Binding EndTime, StringFormat='{0:HH:mm}'}" FontSize="12"
                                       FontAttributes="Bold" TextColor="{StaticResource TextSecondary}"
                                       HorizontalTextAlignment="Center" Margin="0,2,0,0" />
                            </Grid>

                            <Border Grid.Column="1" Grid.RowSpan="2" BackgroundColor="{StaticResource SurfaceColor}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="16,14"
                                    VerticalOptions="Start">
                                <VerticalStackLayout Spacing="6">
                                    <HorizontalStackLayout
                                        IsVisible="{Binding TransitLineName, Converter={StaticResource IsNotNullConverter}}"
                                        Spacing="8">
                                        <Border BackgroundColor="{Binding LineColor, FallbackValue='#4ECDC4'}"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="6,2">
                                            <Label Text="{Binding TransitLineName}" FontSize="12" FontAttributes="Bold"
                                                   TextColor="{Binding LineTextColor, FallbackValue='White'}" />
                                        </Border>
                                        <Label Text="{Binding Headsign, StringFormat='toward {0}'}" FontSize="13"
                                               TextColor="{StaticResource TextSecondary}" VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                    <Label Text="{Binding Instruction}" FontSize="16" FontAttributes="Bold"
                                           TextColor="{StaticResource TextPrimary}" />

                                    <HorizontalStackLayout
                                        IsVisible="{Binding DepartureStopName, Converter={StaticResource IsNotNullConverter}}"
                                        Spacing="6">
                                        <Label Text="📍" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding DepartureStopName, StringFormat='Board at {0}'}"
                                               FontSize="14" TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout Spacing="8">
                                        <Label Text="{Binding Duration.TotalMinutes, StringFormat='{0:F0} min'}"
                                               FontSize="13" TextColor="{StaticResource TextSecondary}" />
                                        <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="13" />
                                        <Label Text="{Binding DistanceMeters, StringFormat='{0:F0} m'}" FontSize="13"
                                               TextColor="{StaticResource TextSecondary}" />

                                        <Label Text="•" TextColor="{StaticResource TextSecondary}" FontSize="13"
                                               IsVisible="{Binding NumberOfStops, Converter={StaticResource IsNotNullConverter}}" />
                                        <Label Text="{Binding NumberOfStops, StringFormat='{0} stops'}" FontSize="13"
                                               TextColor="{StaticResource TextSecondary}"
                                               IsVisible="{Binding NumberOfStops, Converter={StaticResource IsNotNullConverter}}" />
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout
                                        IsVisible="{Binding ArrivalStopName, Converter={StaticResource IsNotNullConverter}}"
                                        Spacing="6">
                                        <Label Text="🏁" FontSize="12" VerticalOptions="Center" />
                                        <Label Text="{Binding ArrivalStopName, StringFormat='Get off at {0}'}"
                                               FontSize="14" TextColor="{StaticResource TextPrimary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>

                                    <Border IsVisible="{Binding HasWaitTime}" BackgroundColor="#2A2A40"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 6" Padding="8,4"
                                            HorizontalOptions="Start" Margin="0,6,0,0">
                                        <Label Text="{Binding WaitTimeAtDeparture, StringFormat='Wait {0:%m} min'}"
                                               FontSize="12" FontAttributes="Bold"
                                               TextColor="{StaticResource WarningYellow}" />
                                    </Border>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>