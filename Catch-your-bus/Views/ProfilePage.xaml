<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Catch_your_bus.Views.ProfilePage"
             xmlns:vm="clr-namespace:Catch_your_bus.ViewModels"
             xmlns:entities="clr-namespace:DAL.Entities;assembly=DAL" x:DataType="vm:ProfileViewModel"
             Title="Profile &amp; Settings" BackgroundColor="#1A1A2E">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="24">

            <Label Text="Your Speeds" FontSize="20" FontAttributes="Bold" TextColor="White" />
            <Border BackgroundColor="#16213E" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="16">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🚶 Walking Pace" TextColor="White" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding WalkingSpeed, StringFormat='{0:F1} km/h'}"
                                   TextColor="#6C63FF" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Slider Minimum="{x:Static vm:ProfileViewModel.MinWalkingSpeedKmH}"
                                Maximum="{x:Static vm:ProfileViewModel.MaxWalkingSpeedKmH}" Value="{Binding WalkingSpeed}" MinimumTrackColor="#6C63FF"
                                DragCompletedCommand="{Binding SaveSpeedsCommand}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="🏃 Running Pace" TextColor="White" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1" Text="{Binding RunningSpeed, StringFormat='{0:F1} km/h'}"
                                   TextColor="#FF8C42" FontAttributes="Bold" VerticalOptions="Center" />
                        </Grid>
                        <Slider Minimum="{x:Static vm:ProfileViewModel.MinRunningSpeedKmH}"
                                Maximum="{x:Static vm:ProfileViewModel.MaxRunningSpeedKmH}" Value="{Binding RunningSpeed}" MinimumTrackColor="#FF8C42"
                                DragCompletedCommand="{Binding SaveSpeedsCommand}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#16213E" StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 16">
                <VerticalStackLayout Spacing="16">
                    <Label Text="GPS Speed Calibration" FontSize="16" FontAttributes="Bold" TextColor="White" />

                    <Label Text="{Binding CalibrationMessage}" TextColor="#A0A0B0" HorizontalTextAlignment="Center" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12"
                          IsVisible="{Binding IsCalibrating, Converter={StaticResource InvertedBoolConverter}}">
                        <Button Grid.Column="0" Text="Test Walk" Command="{Binding StartCalibrationCommand}"
                                CommandParameter="Walk" BackgroundColor="Transparent" BorderColor="#6C63FF"
                                BorderWidth="1" TextColor="#6C63FF" CornerRadius="8" />
                        <Button Grid.Column="1" Text="Test Run" Command="{Binding StartCalibrationCommand}"
                                CommandParameter="Run" BackgroundColor="Transparent" BorderColor="#FF8C42"
                                BorderWidth="1" TextColor="#FF8C42" CornerRadius="8" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsCalibrating}" Spacing="16" HorizontalOptions="Center">
    
                        <Label Text="{Binding ElapsedTime, StringFormat='{0:mm\\:ss}'}" FontSize="48" FontAttributes="Bold" TextColor="White" HorizontalTextAlignment="Center" />
    
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                            <Label Text="{Binding CurrentTestDistanceMeters, StringFormat='{0:F0}'}" FontSize="24" FontAttributes="Bold" TextColor="#6C63FF" />
                            <Label Text="meters" VerticalOptions="End" Margin="0,0,0,6" TextColor="#A0A0B0" />
                        </HorizontalStackLayout>
    
                        <HorizontalStackLayout Spacing="12" HorizontalOptions="Center">
                            <Button Text="Cancel" Command="{Binding CancelCalibrationCommand}" BackgroundColor="Transparent" TextColor="#FF6B6B" BorderWidth="1" BorderColor="#FF6B6B" CornerRadius="8" />
        
                            <Button Text="🛑 Stop &amp; Calculate" Command="{Binding StopCalibrationCommand}" BackgroundColor="#FF6B6B" TextColor="White" CornerRadius="8" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Label Text="Manage Favorites" FontSize="20" FontAttributes="Bold" TextColor="White" Margin="0,10,0,0" />
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Favorites}" Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="entities:FavoriteRoute">
                        <Border BackgroundColor="#16213E" StrokeThickness="0" Padding="16"
                                StrokeShape="RoundRectangle 12">
                            <Grid ColumnDefinitions="*, Auto">
                                <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                    <Label Text="{Binding Name}" FontSize="15" FontAttributes="Bold" TextColor="White" />
                                    <Label Text="{Binding StartLocationName, StringFormat='From: {0}'}" FontSize="12"
                                           TextColor="#A0A0B0" LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Button Grid.Column="1" Text="🗑️"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ProfileViewModel}}, Path=DeleteFavoriteCommand}"
                                        CommandParameter="{Binding .}" BackgroundColor="Transparent" FontSize="20" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>