<?xml version="1.0" encoding="UTF-8"?>

<Shell
    x:Class="Catch_your_bus.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Catch_your_bus.Views"
    Title="Catch_your_bus">

    <TabBar>
        <Tab Title="Calculator" Icon="search.svg">
            <ShellContent ContentTemplate="{DataTemplate views:RouteCalculationPage}" Route="RouteCalculationPage" />
        </Tab>
        <Tab Title="History" Icon="history.svg">
            <ShellContent ContentTemplate="{DataTemplate views:RunHistoryPage}" />
        </Tab>
        <Tab Title="Profile" Icon="settings.svg">
            <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" Route="ProfilePage" />
        </Tab>
    </TabBar>
</Shell>